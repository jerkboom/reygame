# =================================================================
# ReyGames - Environment Configuration Template
# Copy this file to .env or configure in your deployment platform
# DO NOT COMMIT REAL SECRETS OR .env FILES TO GIT
# =================================================================

# Server Port (default 3000)
PORT=3000

# Public App URLs
APP_URL="http://localhost:3000"
PUBLIC_APP_URL="http://localhost:3000"

# Paystack Payment Gateway (Ghana GHS Mobile Money & Card Checkout)
# Public key is used on client for Paystack Inline checkout
VITE_PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
# Secret key is NEVER exposed to browser; used server-side for transaction init, verification, and webhooks
PAYSTACK_SECRET_KEY=your_paystack_secret_key

# Administrator Authentication & Security
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_admin_password
ADMIN_SESSION_SECRET=generate_a_secure_secret

# Customer Delivery & Purchase Notification Emails (Choose ONE provider)
# Option 1: Gmail SMTP (Send directly via Google 16-character App Password)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Option 2: Resend API (https://resend.com)
RESEND_API_KEY=your_resend_api_key
EMAIL_PROVIDER_API_KEY=your_email_provider_api_key

# Option 3: SendGrid API (https://sendgrid.com)
SENDGRID_API_KEY=your_sendgrid_api_key

# Option 4: Custom SMTP
SMTP_HOST=your_smtp_host
SMTP_PORT=465
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_SECURE=true
SMTP_FROM=your_smtp_from_address

# Store Sender Name & Admin Recipient
EMAIL_FROM="ReyGames <orders@yourdomain.com>"
ADMIN_NOTIFICATION_EMAIL=your_admin_notification_email@example.com

# Cloudinary Media Storage (Game Cover Uploads)
# Server-side only - NEVER expose API secret to the browser
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional Gemini AI API Key (if AI Studio features are used)
GEMINI_API_KEY=your_gemini_api_key
